DATABASE_URL=postgresql://afterglow:afterglow-dev@localhost:5432/afterglow
PORT=4000
JWT_SECRET=change-me
# OAuth 2.0 Web client ID from Google Cloud Console (same value as client VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=

# Photo storage: "local" writes to server/uploads, "r2" uses Cloudflare R2
STORAGE_DRIVER=local
# Required when STORAGE_DRIVER=r2. Use an R2 API token scoped to this bucket only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
